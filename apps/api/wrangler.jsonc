{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tv-api",
  "account_id": "e19b9bdd14629a58c3f213b37a58281e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "47ccb95cf03f436a8b348a81364029b9",
      "localConnectionString": "postgresql://tv:tv@127.0.0.1:5433/tv"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "tv.perd.dev/api/auth/*",
      "zone_name": "perd.dev"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "tv-api-staging",
      "limits": {
        "cpu_ms": 1000
      },
      "hyperdrive": [
        {
          "binding": "DATABASE",
          "id": "fd651cc73ce943039fc6eb9781410f08",
          "localConnectionString": "postgresql://tv:tv@127.0.0.1:5433/tv"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "routes": [
        {
          "pattern": "tv-staging.perd.dev/api/auth/*",
          "zone_name": "perd.dev"
        }
      ]
    }
  }
}
