{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tv-api",
  "account_id": "e19b9bdd14629a58c3f213b37a58281e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET"
    ]
  },
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "47ccb95cf03f436a8b348a81364029b9",
      "localConnectionString": "postgresql://tv:tv@127.0.0.1:5433/tv"
    }
  ],
  "ratelimits": [
    {
      "name": "REGISTRATION_EMAIL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "REGISTRATION_ACTIVATION_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SIGN_IN_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@perd.dev"
      ]
    }
  ],
  "vars": {
    "WEB_ORIGIN": "https://tv.perd.dev"
  },
  "routes": [
    {
      "pattern": "tv.perd.dev/api/*",
      "zone_name": "perd.dev"
    }
  ],
  "dev": {
    "host": "127.0.0.1",
    "ip": "127.0.0.1",
    "port": 8788
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "tv-api-staging",
      "limits": {
        "cpu_ms": 1000
      },
      "secrets": {
        "required": [
          "TURNSTILE_SECRET"
        ]
      },
      "hyperdrive": [
        {
          "binding": "DATABASE",
          "id": "fd651cc73ce943039fc6eb9781410f08",
          "localConnectionString": "postgresql://tv:tv@127.0.0.1:5433/tv"
        }
      ],
      "ratelimits": [
        {
          "name": "REGISTRATION_EMAIL_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 1,
            "period": 60
          }
        },
        {
          "name": "REGISTRATION_ACTIVATION_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "SIGN_IN_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_destination_addresses": [
            "tv@kekus.slmail.me"
          ],
          "allowed_sender_addresses": [
            "noreply@perd.dev"
          ]
        }
      ],
      "vars": {
        "WEB_ORIGIN": "https://tv-staging.perd.dev"
      },
      "routes": [
        {
          "pattern": "tv-staging.perd.dev/api/*",
          "zone_name": "perd.dev"
        }
      ]
    }
  }
}
