{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tv-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
