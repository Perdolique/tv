{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tv-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public"
  },
  "routes": [
    {
      "pattern": "tv.perd.dev",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "tv-api"
    }
  ],
  "vars": {
    "NUXT_PUBLIC_REGISTRATION_ENABLED": "true"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 3001
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "tv-web-staging",
      "vars": {
        "NUXT_PUBLIC_REGISTRATION_ENABLED": "false"
      },
      "routes": [
        {
          "pattern": "tv-staging.perd.dev",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "API",
          "service": "tv-api-staging"
        }
      ]
    }
  }
}
