{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tv-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public"
  },
  "services": [
    {
      "binding": "API",
      "service": "tv-api"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 3001
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
