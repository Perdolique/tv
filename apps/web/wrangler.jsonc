{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tv-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
